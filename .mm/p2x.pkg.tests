# the p2x package testsuite
p2x.pkg.tests.stem := p2x.pkg
# it needs the package installed before it can run
p2x.pkg.tests.prerequisites := p2x.pkg

# clean up after pytest, which leaves its bytecode cache behind
tests.p2x.pkg.clean := __pycache__


# end of file
