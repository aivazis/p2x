{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "codespell: check the prose of the tracked files",
            "type": "shell",
            "command": "git ls-files -z | xargs -0 codespell --toml pyproject.toml",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": {
                "owner": "codespell",
                "source": "codespell",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "severity": "warning",
                "pattern": {
                    "regexp": "^(.+?):(\\d+): (.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        }
    ]
}
