{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "p2x: debug the current python file",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "p2x: debug the current test with pytest",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "args": [
                "${file}"
            ],
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "mm: debug test driver with lldb",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}"
        },
        {
            "name": "p2x: debug C++ extension with lldb",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}"
        }
    ]
}
